{
  "name": "mj-kang-site",
  "version": "1.0.0",
  "description": "Static portfolio site for mj-kang.com",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:generated": "node scripts/build.mjs --check",
    "test": "npm run check:generated && npm run test:structure && npm run test:counter && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:structure": "python3 tests/homepage_structure_test.py",
    "test:counter": "node --test tests/counter.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjkang-estrella/mjkang-estrella.github.io.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mjkang-estrella/mjkang-estrella.github.io/issues"
  },
  "homepage": "https://github.com/mjkang-estrella/mjkang-estrella.github.io#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "private": true
}
